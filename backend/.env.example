# ─────────────────────────────────────────────────────
#  Astrofest Backend – Environment Variables
#  Copy this file to .env and fill in the values.
#  .env is git-ignored and MUST NOT be committed.
# ─────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── Database ─────────────────────────────────────────
# Development (SQLite fallback – no server needed):
# DATABASE_URL=sqlite:///./astrofest.db

# Production / Neon PostgreSQL:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# ── CORS ─────────────────────────────────────────────
# Development:
# FRONTEND_ORIGIN=http://localhost:3000
# Production (your Vercel deployment URL):
FRONTEND_ORIGIN=https://your-project.vercel.app

# ── SMTP (optional – for confirmation emails) ────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@astrofest.nitk.edu.in
